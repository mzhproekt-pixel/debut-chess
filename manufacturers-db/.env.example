# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://mdb:mdb@localhost:5432/manufacturers

# Optional API keys (most sources work without auth, but some have higher rate limits with a key)
COMPANIES_HOUSE_API_KEY=
OPENCORPORATES_API_TOKEN=
COMTRADE_PRIMARY_KEY=

# Where to write CSV exports (relative to project root)
EXPORT_DIR=./exports

# User-Agent for API calls (some APIs like SEC EDGAR require it)
HTTP_USER_AGENT=manufacturers-db/0.1 (contact: your-email@example.com)

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
